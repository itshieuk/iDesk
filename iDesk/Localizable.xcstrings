          "stringUnit": {
            "state": "translated",
            "value": "Ghim nửa trái"
          }
        }
      }
    },
    "Snap right": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghim nửa phải"
          }
        }
      }
    },
    "Snap, maximize, minimize the window": {
      "localizations": {
