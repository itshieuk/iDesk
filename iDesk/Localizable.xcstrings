      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong"
          }
        }
      }
    },
    "Downloaded %@. Open it from Files.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tải %@. Mở trong Tệp."
          }
        }
      }
    },
    "Downloading %@…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải %@…"
          }
        }
      }
    },
    "Downloads and screenshots. Click a file to open it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "File đã tải và ảnh chụp màn hình. Bấm vào file để mở."
          }
        }
      }
    },
    "Drag one finger to move the pointer, tap to click, two-finger tap to right-click, two-finger drag to scroll, three-finger swipe up for recent apps": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo một ngón để di chuột, chạm để nhấp, chạm hai ngón để nhấp chuột phải, kéo hai ngón để cuộn, vuốt ba ngón lên để xem ứng dụng gần đây"
          }
        }
      }
    },
    "Each key typed on the iPhone keyboard goes straight to the desktop": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi phím gõ trên bàn phím iPhone được gửi thẳng lên desktop"
          }
        }
      }
    },
    "Every app runs inside iDesk, so many open windows make everything slower.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi app đều chạy bên trong iDesk, nên mở nhiều cửa sổ sẽ làm mọi thứ chậm đi."
          }
        }
      }
    },
    "Every app runs inside iDesk, so many open windows make everything slower. When the limit is reached, close a window before opening another.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi app đều chạy bên trong iDesk, nên mở nhiều cửa sổ sẽ làm mọi thứ chậm đi. Khi đã đủ số này, hãy đóng bớt một cửa sổ rồi mới mở cái khác."
          }
        }
      }
    },
    "Exit mouse mode": {
      "localizations": {
