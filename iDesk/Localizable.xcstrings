      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả app"
          }
        }
      }
    },
    "Always show the mouse mode button": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn hiện nút chế độ chuột"
          }
        }
      }
    },
    "Always show the taskbar": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn hiện thanh tác vụ"
          }
        }
      }
    },
    "Applies to finger swipes on the trackpad and to GameController mice.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho vuốt ngón tay trên trackpad và chuột qua GameController."
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng"
          }
        }
      }
    },
    "Apps and files": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App và tệp"
          }
        }
      }
    },
    "Apps from IPA": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App từ IPA"
          }
        }
      }
    },
    "Apps installed from IPA files. They open as windows on this desktop.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App cài từ file IPA. Chúng mở thành cửa sổ trên desktop này."
          }
        }
      }
    },
    "Apps installed from the App Store can't appear: iOS doesn't let one app show another app's screen.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App cài từ App Store không hiện được: iOS không cho app này hiện màn hình của app khác."
          }
        }
      }
    },
    "Apps installed from the App Store can't open on the desktop. Most of them have a website that works in a window instead.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App cài từ App Store không mở được trên màn hình nền. Phần lớn có trang web dùng được trong cửa sổ thay thế."
          }
        }
      }
    },
    "AssistiveTouch can give the right and middle buttons to its own menu: Settings → Accessibility → Touch → AssistiveTouch → Devices lets you change what they do.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AssistiveTouch có thể dùng nút phải và nút giữa cho menu riêng của nó: vào Cài đặt → Trợ năng → Cảm ứng → AssistiveTouch → Thiết bị để đổi chức năng các nút."
          }
        }
      }
    },
    "Audio output": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguồn phát âm thanh"
          }
