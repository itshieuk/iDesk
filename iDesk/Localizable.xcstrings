      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm, cài và gỡ app"
          }
        }
      }
    },
    "Added %lld apps: %@.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thêm %lld app: %@."
