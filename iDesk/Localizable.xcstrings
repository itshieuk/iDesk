    "Settings": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt"
          }
        }
      }
    },
    "Several apps can run at once; each one uses memory, so iOS may close iDesk if too many are open.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy được nhiều app cùng lúc; mỗi app tốn bộ nhớ, nên mở quá nhiều thì iOS có thể tắt iDesk."
          }
        }
      }
    },
    "Show": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện"
          }
        }
      }
    },
    "Show desktop": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện màn hình nền"
          }
        }
      }
