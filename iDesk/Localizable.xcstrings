{
  "sourceLanguage": "en",
  "strings": {
    "%lld windows": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld window"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld windows"
                }
              }
            }
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld cửa sổ"
          }
        }
      }
    },
    "%lld%%": {
      "shouldTranslate": false
    },
    ", expires %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ", hết hạn %@"
          }
        }
      }
    },
    "1 finger: move · Tap: click · Double tap: double-click\nTwo-finger tap: right-click · Two-finger drag: scroll\nHold, then drag: move / resize windows": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ngón: di chuột · Chạm: nhấp · Chạm 2 lần: nhấp đúp\nChạm 2 ngón: chuột phải · Kéo 2 ngón: cuộn\nGiữ rồi kéo: di chuyển / đổi cỡ cửa sổ"
          }
        }
      }
    },
    "Add IPA": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm IPA"
          }
        }
      }
    },
    "Add, install and remove apps": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm, cài và gỡ app"
          }
        }
      }
    },
    "Added %lld apps: %@.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thêm %lld app: %@."
