    },
    "iDesk": {
      "shouldTranslate": false
    },
    "iDesk has get-task-allow (development certificate).": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk có quyền get-task-allow (chứng chỉ phát triển)."
          }
        }
      }
    },
    "iDesk is signed by Team: %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk đang được ký bởi Team: %@"
          }
        }
      }
    },
    "iDesk lacks get-task-allow: iOS may reject apps signed on this device; install them into iDesk through ESign instead.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk không có quyền get-task-allow: tự ký trên máy có thể bị iOS từ chối, nên dùng nút Xuất cho ESign."
          }
        }
      }
    },
    "iDesk quit unexpectedly last time. Tap “Copy error” and send the text below:": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk bị thoát ở lần chạy trước. Bấm “Sao chép lỗi” và gửi nội dung dưới đây:"
          }
        }
      }
    },
    "iDesk was paused while the iPhone was locked or showing another app. Keep iDesk open on the iPhone while you work.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk đã tạm dừng khi iPhone bị khóa hoặc đang mở app khác. Hãy để iDesk mở trên iPhone khi làm việc."
          }
        }
      }
    },
    "iOS apps run only from decrypted IPA files added to iDesk (next page). Not every app works inside it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App iOS chỉ chạy từ file IPA đã giải mã được thêm vào iDesk (trang sau). Không phải app nào cũng chạy được."
          }
        }
      }
    },
    "iOS only runs code inside an installed app, not from iDesk’s data folder.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chỉ cho chạy mã nằm trong app đã cài, không cho nạp từ thư mục dữ liệu của iDesk."
          }
        }
      }
    },
    "iOS only runs code inside an installed app: package iDesk with the new apps, then sign and install it with ESign (or Feather, Scarlet…) on the iPhone.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chỉ chạy code nằm trong app đã cài: đóng gói iDesk kèm app mới, rồi ký và cài bằng ESign (hoặc Feather, Scarlet…) trên iPhone."
          }
        }
      }
    },
    "iOS only runs code that is inside an installed app, so new apps must be installed into iDesk once: tap the button above, pick ESign (or Feather, Scarlet… whichever signing app you use), then sign and install as usual. Reopen iDesk and the app runs.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chỉ cho chạy mã nằm trong app đã cài, nên app mới phải được cài vào iDesk một lần: bấm nút trên, chọn ESign (hoặc Feather, Scarlet… app ký bạn dùng), ký và cài như cài app bình thường. Mở lại iDesk là app chạy."
          }
        }
      }
    },
    "iOS rejected the guest app’s signature.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS từ chối chữ ký của app khách."
          }
        }
      }
    },
    "iOS reports a mouse but sends iDesk no movement. Turn on AssistiveTouch to use it through its pointer.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS báo có chuột nhưng không gửi chuyển động nào cho iDesk. Hãy bật AssistiveTouch để dùng chuột qua con trỏ của nó."
          }
        }
      }
    },
    "iOS reports no mouse to iDesk. On iPhone a mouse is turned on by AssistiveTouch: Settings → Accessibility → Touch → AssistiveTouch, then connect the mouse.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS không báo chuột nào cho iDesk. Trên iPhone, chuột được bật bằng AssistiveTouch: Cài đặt → Trợ năng → Cảm ứng → AssistiveTouch, rồi kết nối chuột."
          }
        }
      }
    },
