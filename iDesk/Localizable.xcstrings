      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm file IPA…"
          }
        }
      }
    },
    "Add iOS apps from decrypted IPA files with the box button on the trackpad.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm app iOS từ file IPA đã giải mã bằng nút hình hộp trên trackpad."
          }
        }
      }
    },
    "Add to desktop": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm vào màn hình nền"
          }
        }
