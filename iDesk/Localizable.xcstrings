{
  "sourceLanguage": "en",
  "strings": {
    "%@ (web)": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (web)"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld"
          }
        }
      }
    },
    "%lld windows": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld window"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld windows"
                }
              }
            }
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld cửa sổ"
          }
        }
      }
    },
    "%lld%%": {
      "shouldTranslate": false
    },
    ", expires %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ", hết hạn %@"
          }
        }
      }
    },
    "1 finger: move · Tap: click · Double tap: double-click\nTwo-finger tap: right-click · Two-finger drag: scroll\nHold, then drag: move / resize windows\nThree fingers: up = recent apps, down = home, tap = back": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ngón: di chuột · Chạm: nhấp · Chạm 2 lần: nhấp đúp\nChạm 2 ngón: chuột phải · Kéo 2 ngón: cuộn\nGiữ rồi kéo: di chuyển / đổi cỡ cửa sổ\nBa ngón: vuốt lên = ứng dụng gần đây, xuống = màn hình chính, chạm = quay lại"
          }
        }
      }
    },
    "A Bluetooth keyboard works right away: pair it in the iPhone's Settings → Bluetooth.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn phím Bluetooth dùng được ngay: ghép nối trong Cài đặt → Bluetooth của iPhone."
          }
        }
      }
    },
    "A hub with a power port charges the iPhone while you work.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hub có cổng sạc sẽ sạc iPhone trong lúc bạn làm việc."
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ năng"
          }
        }
      }
    },
    "Actual size": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cỡ thật"
          }
        }
      }
    },
    "Add IPA": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm IPA"
          }
        }
      }
    },
