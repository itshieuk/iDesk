    "iDesk has get-task-allow (development certificate).": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk có quyền get-task-allow (chứng chỉ phát triển)."
          }
        }
      }
    },
    "iDesk is signed by Team: %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk đang được ký bởi Team: %@"
          }
        }
      }
    },
    "iDesk lacks get-task-allow: iOS may reject apps signed on this device; install them into iDesk through ESign instead.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk không có quyền get-task-allow: tự ký trên máy có thể bị iOS từ chối, nên dùng nút Xuất cho ESign."
          }
        }
      }
    },
    "iDesk quit unexpectedly last time. Tap “Copy error” and send the text below:": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk bị thoát ở lần chạy trước. Bấm “Sao chép lỗi” và gửi nội dung dưới đây:"
          }
        }
      }
    },
    "iOS only runs code inside an installed app, not from iDesk’s data folder.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chỉ cho chạy mã nằm trong app đã cài, không cho nạp từ thư mục dữ liệu của iDesk."
          }
        }
      }
    },
    "iOS only runs code that is inside an installed app, so new apps must be installed into iDesk once: tap the button above, pick ESign (or Feather, Scarlet… whichever signing app you use), then sign and install as usual. Reopen iDesk and the app runs.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chỉ cho chạy mã nằm trong app đã cài, nên app mới phải được cài vào iDesk một lần: bấm nút trên, chọn ESign (hoặc Feather, Scarlet… app ký bạn dùng), ký và cài như cài app bình thường. Mở lại iDesk là app chạy."
          }
        }
      }
    },
    "iOS rejected the guest app’s signature.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS từ chối chữ ký của app khách."
          }
        }
