    "Window": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa sổ"
          }
        }
      }
    },
    "cannot parse the certificate.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không phân tích được chứng chỉ."
          }
        }
      }
    },
    "cannot read the .p12 file (code %@).": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không đọc được file .p12 (mã %@)."
          }
        }
      }
    },
    "cannot start the decompressor": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không khởi tạo được bộ giải nén"
          }
        }
      }
    },
    "central directory": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "mục lục"
          }
        }
      }
    },
    "compressed data": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "dữ liệu nén"
          }
        }
      }
    },
    "compression method %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "kiểu nén %@"
          }
        }
      }
    },
    "iDesk": {
      "shouldTranslate": false
    },
    "iDesk has get-task-allow (development certificate).": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk có quyền get-task-allow (chứng chỉ phát triển)."
          }
        }
      }
    },
    "iDesk is signed by Team: %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk đang được ký bởi Team: %@"
          }
        }
      }
    },
    "iDesk lacks get-task-allow: iOS may reject apps signed on this device; install them into iDesk through ESign instead.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk không có quyền get-task-allow: tự ký trên máy có thể bị iOS từ chối, nên dùng nút Xuất cho ESign."
          }
        }
      }
    },
    "iDesk quit unexpectedly last time. Tap “Copy error” and send the text below:": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iDesk bị thoát ở lần chạy trước. Bấm “Sao chép lỗi” và gửi nội dung dưới đây:"
          }
        }
      }
    },
    "iOS only runs code inside an installed app, not from iDesk’s data folder.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chỉ cho chạy mã nằm trong app đã cài, không cho nạp từ thư mục dữ liệu của iDesk."
          }
        }
      }
    },
    "iOS only runs code that is inside an installed app, so new apps must be installed into iDesk once: tap the button above, pick ESign (or Feather, Scarlet… whichever signing app you use), then sign and install as usual. Reopen iDesk and the app runs.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chỉ cho chạy mã nằm trong app đã cài, nên app mới phải được cài vào iDesk một lần: bấm nút trên, chọn ESign (hoặc Feather, Scarlet… app ký bạn dùng), ký và cài như cài app bình thường. Mở lại iDesk là app chạy."
          }
        }
      }
    },
    "iOS rejected the guest app’s signature.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS từ chối chữ ký của app khách."
          }
        }
      }
    },
    "iPhone": {
      "shouldTranslate": false
    },
    "no .p12 file chosen.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "chưa chọn file .p12."
          }
        }
      }
    },
    "password encryption": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "mã hoá bằng mật khẩu"
          }
        }
      }
    },
    "the .mobileprovision file is damaged or in the wrong format.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "file .mobileprovision hỏng hoặc không đúng định dạng."
          }
        }
      }
    },
    "the .p12 file has no private key.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "file .p12 không có khoá riêng."
          }
        }
      }
    },
    "the certificate has no Team ID.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "chứng chỉ không có Team ID."
          }
        }
      }
    },
    "the signature is larger than expected": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "chữ ký lớn hơn dự tính"
          }
        }
      }
    },
    "unknown": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không rõ"
          }
        }
      }
    },
    "unreadable": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không đọc được"
          }
        }
      }
    },
    "Windows": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa sổ"
          }
        }
      }
    },
    "Workspace %lld": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình ảo %lld"
          }
        }
      }
    },
    "wrong password.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "sai mật khẩu."
          }
        }
      }
    },
    "“%@” is not installed into iDesk yet. iOS only runs code inside an installed app: tap the box button → “Install new apps into iDesk”, pick ESign (or your signing app), then sign and install as usual. Reopen iDesk and it runs.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” chưa được cài vào iDesk. iOS chỉ cho chạy mã nằm trong app đã cài: mở nút hình hộp → “Cài app mới vào iDesk”, chọn ESign (hoặc app ký bạn dùng), ký và cài như bình thường. Mở lại iDesk là chạy."
          }
        }
      }
    },
    "“%@” is not signed because iDesk has no certificate. Tap the box button → Import certificate and choose the certificate .zip (the one you used to install iDesk). You only need to do this once.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” chưa được ký vì iDesk chưa có chứng chỉ. Bấm nút hình hộp → Nhập chứng chỉ, chọn file .zip chứng chỉ (cùng file bạn dùng để cài iDesk). Chỉ cần làm một lần."
          }
        }
      }
    },
    "⚠️ The .mobileprovision file does not match this certificate.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ File .mobileprovision không đi với chứng chỉ này."
          }
        }
      }
    },
    "⚠️ The Team ID differs from the certificate signing iDesk (%@); iOS will refuse to load apps. Sign iDesk in ESign with this same certificate.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Team ID khác chứng chỉ đang ký iDesk (%@), iOS sẽ từ chối nạp app. Hãy ký iDesk trong ESign bằng chính chứng chỉ này."
          }
        }
      }
    },
    "⚠️ The profile has expired.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Hồ sơ đã hết hạn."
          }
        }
      }
    }
  },
  "version": "1.0"
}
