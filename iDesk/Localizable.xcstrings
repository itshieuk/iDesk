            "value": "Màn hình nền"
          }
        }
      }
    },
    "Details:": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi tiết:"
          }
        }
      }
    },
    "Different Team ID from iDesk (%@): iOS will refuse to load the app.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khác Team ID của iDesk (%@) - iOS sẽ từ chối nạp app."
