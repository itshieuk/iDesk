    "Decrypted IPAs only. Swipe left to delete an app or remove it from iDesk to save space. Several apps can run at once; each one uses memory, so iOS may close iDesk if too many are open.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ nhận IPA đã giải mã. Vuốt sang trái để xoá hoặc gỡ app khỏi iDesk cho nhẹ. Chạy được nhiều app cùng lúc; mỗi app tốn RAM nên mở quá nhiều thì iOS có thể tắt iDesk."
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoá"
          }
        }
      }
    },
