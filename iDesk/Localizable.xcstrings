    "Connect an external display first; the app opens as a window on the desktop.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cắm màn hình ngoài trước, app sẽ mở thành cửa sổ trên desktop."
          }
        }
      }
    },
