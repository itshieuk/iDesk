    "Show window": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện cửa sổ"
          }
        }
      }
    },
    "Show windows again": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện lại cửa sổ"
          }
        }
      }
    },
    "Shows 1 2 3 4 on the taskbar to keep windows on separate desktops: Win + Ctrl + ← → or a four-finger swipe switches between them.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện 1 2 3 4 trên thanh tác vụ để chia cửa sổ ra nhiều màn hình nền: Win + Ctrl + ← → hoặc vuốt bốn ngón để chuyển."
          }
        }
      }
    },
    "Shows what the mouse sends to iDesk": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem chuột gửi gì cho iDesk"
          }
        }
      }
    },
    "Signing failed: %@": {
      "localizations": {
        "vi": {
